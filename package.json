{
  "name": "autonomous-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Genre-agnostic public boilerplate for DSH autonomy experiments (CI + Pages + branch model)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
