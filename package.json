{
  "name": "autonomous-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Genre-agnostic public boilerplate for DSH autonomy experiments (CI + Pages + branch model)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "gate": "npm run typecheck && npm run lint && npm run boundaries && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.39.1",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
